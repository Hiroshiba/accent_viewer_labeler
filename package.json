{
  "name": "accent-viewer-labeler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @accent-viewer/web dev",
    "dev:electron": "pnpm --filter @accent-viewer/electron dev",
    "build:web": "pnpm --filter @accent-viewer/web build",
    "build:electron": "pnpm --filter @accent-viewer/electron build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint --cache .",
    "format": "eslint --cache --fix . && prettier --cache --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "6.0.4",
    "eslint": "10.0.2",
    "eslint-config-flat-gitignore": "2.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.8.0",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
